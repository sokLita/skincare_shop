<script>
import axios from 'axios'

export default {
  name: 'LandingPage',
  data() {
    return {
      signupForm: {
        name: '',
        email: '',
        password: '',
        agree: false
      },
      signupLoading: false,
      signupError: '',
      showPassword: false
    }
  },
  methods: {
    async handleSignUp() {
      this.signupLoading = true
      this.signupError = ''
      try {
        await axios.post('/register', {
          name: this.signupForm.name,
          email: this.signupForm.email,
          password: this.signupForm.password
        })
        this.$router.push('/login')
      } catch (error) {
        this.signupError = error.response?.data?.message || 'Unable to create account. Please try again.'
      } finally {
        this.signupLoading = false
      }
    }
  }
}
</script>

<style scoped>
