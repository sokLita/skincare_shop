  animation: glowPulse 8s ease-in-out infinite 2s;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.2); }
}

/* ---- Botanical Decorations ---- */
.botanical {
  position: absolute;
  pointer-events: none;
  opacity: 0.5;
  z-index: 1;
}
.botanical--leaf-1 {
  top: 12%; left: 5%;
  width: 80px;
  animation: sway 8s ease-in-out infinite;
}
.botanical--leaf-2 {
